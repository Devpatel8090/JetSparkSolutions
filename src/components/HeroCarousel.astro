---
import site from '../data/site.json';

const slides = site.heroSlides;
const waHref = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(`Hi ${site.name}, I'd like to order fire safety products.`)}`;
const hrefFor = (href: string) => (href === 'whatsapp' ? waHref : href);
---

<section class="hero-carousel" aria-roledescription="carousel" aria-label="Highlights">
  <div class="track" id="hero-track">
    {slides.map((s, i) => {
      const Heading = i === 0 ? 'h1' : 'h2';
      return (
      <div
        class:list={['slide', `slide-${i + 1}`, { active: i === 0 }]}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}`}
      >
        <div class="container hero-grid">
          <div>
            <span class="eyebrow">{s.eyebrow}</span>
            <Heading class="title">{s.title}{' '}<span class="gradient-text">{s.highlight}</span></Heading>
            <p class="lead">{s.text}</p>
            <div class="actions">
              {s.buttons.map((b) => (
                <a
                  href={hrefFor(b.href)}
                  class={`btn btn-${b.style}`}
                  {...(b.href === 'whatsapp' ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {b.label}
                </a>
              ))}
            </div>
          </div>
          <div class="visual">
            {s.image && <img src={s.image} alt={s.imageAlt ?? ''} width="380" class="hero-logo" />}
            {s.products && (
              <div class="product-grid">
                {s.products.map((src) => (
                  <a href="/shop" class="tile"><img src={src} alt="" loading="lazy" /></a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
      );
    })}
  </div>

  <button class="arrow prev" aria-label="Previous slide">‹</button>
  <button class="arrow next" aria-label="Next slide">›</button>
  <div class="dots" role="tablist">
    {slides.map((_, i) => (
      <button class:list={['dot', { active: i === 0 }]} data-index={i} aria-label={`Go to slide ${i + 1}`}></button>
    ))}
  </div>
</section>

<script>
  const INTERVAL = 6000;
  const root = document.querySelector<HTMLElement>('.hero-carousel')!;
  const track = root.querySelector<HTMLElement>('.track')!;
  const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
  const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let index = 0;
  let timer: number | undefined;

  function go(i: number) {
    index = (i + slides.length) % slides.length;
    track.style.transform = `translateX(-${index * 100}%)`;
    slides.forEach((s, n) => {
      s.classList.toggle('active', n === index);
      s.inert = n !== index;
    });
    dots.forEach((d, n) => d.classList.toggle('active', n === index));
  }

  function start() {
    if (reduceMotion || slides.length < 2) return;
    stop();
    timer = window.setInterval(() => go(index + 1), INTERVAL);
  }
  function stop() {
    clearInterval(timer);
  }

  root.querySelector('.prev')!.addEventListener('click', () => { go(index - 1); start(); });
  root.querySelector('.next')!.addEventListener('click', () => { go(index + 1); start(); });
  dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.index)); start(); }));

  root.addEventListener('mouseenter', stop);
  root.addEventListener('mouseleave', start);
  root.addEventListener('focusin', stop);
  root.addEventListener('focusout', start);
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

  // Swipe on touch screens
  let startX = 0;
  root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; stop(); }, { passive: true });
  root.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) go(index + (dx < 0 ? 1 : -1));
    start();
  });

  go(0);
  start();
</script>

<style>
  .hero-carousel { position: relative; overflow: hidden; }
  .track { display: flex; transition: transform .7s cubic-bezier(.65, 0, .35, 1); }
  .slide { flex: 0 0 100%; padding: 64px 0 80px; display: flex; align-items: center; }
  .slide-1 { background: radial-gradient(circle at 80% 30%, #fff1e6, #fff 60%); }
  .slide-2 { background: linear-gradient(120deg, #1f2226 0%, #5a0a0e 55%, #c8161d 100%); color: #fff; }
  .slide-2 .lead { color: #f1dcd2; }
  .slide-2 .gradient-text { background: linear-gradient(90deg, #ffb070, var(--amber)); -webkit-background-clip: text; background-clip: text; }
  .slide-2 .eyebrow { color: var(--amber); }
  .slide-2 .btn-outline { color: #fff; }

  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
  .title { font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: .5px; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 560px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .hero-logo { margin: 0 auto; max-width: 360px; width: 100%; }
  .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 400px; margin: 0 auto; }
  .tile {
    background: linear-gradient(135deg, #fff7f0, #ffe1cb); border-radius: 18px; aspect-ratio: 4 / 3;
    display: grid; place-items: center; box-shadow: 0 10px 30px rgba(0, 0, 0, .25); transition: transform .2s;
  }
  .tile:hover { transform: translateY(-4px) rotate(-1deg); }
  .tile img { width: 85%; height: 85%; object-fit: contain; }

  /* Slide-in animation for the active slide's text */
  .slide .hero-grid > div { opacity: 0; transform: translateY(16px); transition: opacity .6s .25s, transform .6s .25s; }
  .slide.active .hero-grid > div { opacity: 1; transform: none; }

  .arrow {
    position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%;
    border: none; background: rgba(255, 255, 255, .85); color: var(--red); font-size: 1.8rem; line-height: 1;
    cursor: pointer; box-shadow: var(--shadow); display: grid; place-items: center; padding-bottom: 4px;
  }
  .arrow:hover { background: #fff; }
  .prev { left: 16px; }
  .next { right: 16px; }
  .dots { position: absolute; left: 0; right: 0; bottom: 24px; display: flex; justify-content: center; gap: 10px; }
  .dot { width: 12px; height: 12px; border-radius: 999px; border: 2px solid var(--orange); background: rgba(255,255,255,.7); cursor: pointer; padding: 0; transition: width .3s; }
  .dot.active { width: 34px; background: var(--orange); }

  @media (max-width: 1240px) { .arrow { display: none; } }
  @media (max-width: 820px) {
    .slide { padding: 40px 0 72px; }
    .hero-grid { grid-template-columns: 1fr; gap: 24px; }
    .visual { order: -1; }
    .hero-logo { max-width: 200px; }
    .product-grid { max-width: 300px; gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .track, .slide .hero-grid > div { transition: none; }
  }
</style>
