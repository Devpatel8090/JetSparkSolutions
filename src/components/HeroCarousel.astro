---
import site from '../data/site.json';
import FireBackground from './FireBackground.astro';
import Flame from './Flame.astro';

const slides = site.heroSlides;
const defaultWaText = `Hi ${site.name}, I'd like to know more about your fire safety services.`;
const hrefFor = (href: string, waText?: string) =>
  href === 'whatsapp' ? `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(waText ?? defaultWaText)}` : href;
const btnClass = (style: string) => (style === 'primary' ? 'btn btn-primary' : 'btn btn-ghost');
---

<section class="hero fire-section" aria-roledescription="carousel" aria-label="Highlights">
  <FireBackground embers={36} />

  <div class="track">
    {slides.map((s, i) => {
      const Heading = i === 0 ? 'h1' : 'h2';
      return (
        <div
          class:list={['slide', { active: i === 0 }]}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
        >
          <div class="container hero-grid">
            <div class="copy">
              <span class="pill">{s.eyebrow}</span>
              <Heading class="title">
                {s.title}{' '}<span class="gradient-text">{s.highlight}</span>
                {s.titleEnd && <>{' '}{s.titleEnd}</>}
              </Heading>
              <p class="lead">{s.text}</p>
              <div class="actions">
                {s.buttons.map((b) => (
                  <a
                    href={hrefFor(b.href, s.whatsappText)}
                    class={btnClass(b.style)}
                    {...(b.href === 'whatsapp' ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    {b.label}
                  </a>
                ))}
              </div>
              {s.note && <p class="note">{s.note}</p>}
            </div>

            <div class="visual">
              {s.visual === 'flame' && (
                <div class="orbit">
                  <div class="ring r1"></div>
                  <div class="ring r2"></div>
                  <div class="ring r3"></div>
                  <Flame />
                  {site.certifications.map((c, n) => (
                    <div class={`float-card fc-${n + 1}`}>
                      <span class="fc-icon">{c.icon}</span>
                      <span><strong>{c.title}</strong><small>{c.sub}</small></span>
                    </div>
                  ))}
                </div>
              )}
              {s.badges && (
                <div class="badges">
                  {s.badges.map((b, n) => (
                    <div class:list={['badge', `badge-${n + 1}`]}>
                      <strong>{b.big}</strong>
                      <span>{b.small}</span>
                      <small>{b.sub}</small>
                    </div>
                  ))}
                </div>
              )}
              {s.products && (
                <div class="product-grid">
                  {s.products.map((src) => (
                    <a href="/shop" class="tile"><img src={src} alt="" loading="lazy" /></a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="container controls">
    <button class="arrow prev" aria-label="Previous slide">‹</button>
    <div class="dots">
      {slides.map((_, i) => (
        <button class:list={['dot', { active: i === 0 }]} data-index={i} aria-label={`Go to slide ${i + 1}`}></button>
      ))}
    </div>
    <button class="arrow next" aria-label="Next slide">›</button>
  </div>

  <div class="container stats">
    {site.stats.map((st) => (
      <div class="stat">
        <strong>{st.value}{st.suffix && <span>{st.suffix}</span>}</strong>
        <small>{st.label}</small>
      </div>
    ))}
  </div>
</section>

<script>
  const INTERVAL = 4000; // milliseconds each slide stays on screen
  const root = document.querySelector<HTMLElement>('.hero')!;
  const track = root.querySelector<HTMLElement>('.track')!;
  const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
  const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let index = 0;
  let timer: number | undefined;

  function go(i: number) {
    index = (i + slides.length) % slides.length;
    track.style.transform = `translateX(-${index * 100}%)`;
    slides.forEach((s, n) => {
      s.classList.toggle('active', n === index);
      s.inert = n !== index;
    });
    dots.forEach((d, n) => d.classList.toggle('active', n === index));
  }
  function start() {
    if (reduceMotion || slides.length < 2) return;
    stop();
    timer = window.setInterval(() => go(index + 1), INTERVAL);
  }
  function stop() {
    clearInterval(timer);
  }

  root.querySelector('.prev')!.addEventListener('click', () => { go(index - 1); start(); });
  root.querySelector('.next')!.addEventListener('click', () => { go(index + 1); start(); });
  dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.index)); start(); }));

  track.addEventListener('mouseenter', stop);
  track.addEventListener('mouseleave', start);
  root.addEventListener('focusin', stop);
  root.addEventListener('focusout', start);
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

  let startX = 0;
  track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; stop(); }, { passive: true });
  track.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) go(index + (dx < 0 ? 1 : -1));
    start();
  });

  go(0);
  start();
</script>

<style>
  .hero { padding-bottom: 48px; }
  .track { display: flex; transition: transform .7s cubic-bezier(.65, 0, .35, 1); }
  .slide { flex: 0 0 100%; padding: 72px 0 24px; display: flex; align-items: center; }
  .hero-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 40px; align-items: center; min-height: 480px; }

  .pill {
    display: inline-block; padding: 9px 20px; border-radius: 999px; font-weight: 700; letter-spacing: .5px;
    color: var(--amber); background: rgba(245, 165, 36, .08); border: 1px solid rgba(245, 165, 36, .35); margin-bottom: 26px;
  }
  .title { font-size: clamp(2.4rem, 5vw, 4.1rem); margin-bottom: 24px; color: #fff; }
  .lead { font-size: 1.15rem; max-width: 580px; line-height: 1.8; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }
  .actions .btn { padding: 16px 30px; font-size: 1.05rem; }
  .note { font-size: .85rem; color: #9c948d; margin: 16px 0 0; }

  /* Text animates in on the active slide */
  .copy { opacity: 0; transform: translateY(18px); transition: opacity .6s .2s, transform .6s .2s; }
  .slide.active .copy { opacity: 1; transform: none; }

  /* Flame + orbit visual */
  .orbit { position: relative; width: 420px; height: 420px; margin: 0 auto; display: grid; place-items: center; }
  .ring { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(240, 122, 34, .22); }
  .r1 { inset: 40px; background: radial-gradient(circle, rgba(214, 43, 31, .35), rgba(90, 20, 10, .25) 60%, transparent 72%); border-color: rgba(240,122,34,.3); }
  .r2 { inset: 14px; border-style: dashed; animation: spin 60s linear infinite; }
  .r3 { inset: -14px; border-color: rgba(240, 122, 34, .1); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .float-card {
    position: absolute; display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 14px;
    background: rgba(40, 30, 28, .72); border: 1px solid rgba(255, 255, 255, .12); backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, .35); animation: bob 5s ease-in-out infinite; white-space: nowrap;
  }
  .float-card strong { display: block; color: #fff; font-family: var(--font-head); font-size: 1.02rem; }
  .float-card small { display: block; color: #bdb4ad; font-size: .85rem; }
  .fc-icon { font-size: 1.6rem; }
  .fc-1 { top: 36px; right: -40px; }
  .fc-2 { top: 58%; right: -90px; animation-delay: -1.6s; }
  .fc-3 { bottom: 60px; left: -70px; animation-delay: -3.2s; }
  @keyframes bob { 50% { transform: translateY(-10px); } }

  /* Offer badges */
  .badges { position: relative; height: 360px; max-width: 440px; margin: 0 auto; }
  .badge {
    position: absolute; border-radius: 50%; display: flex; flex-direction: column; align-items: center;
    justify-content: center; text-align: center; color: #fff;
  }
  .badge strong { font-family: var(--font-head); font-weight: 800; line-height: 1; }
  .badge span { font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
  .badge-1 {
    width: 280px; height: 280px; left: 0; top: 0; background: var(--grad);
    box-shadow: 0 0 0 10px rgba(240, 122, 34, .15), 0 0 80px rgba(240, 90, 30, .55);
  }
  .badge-1 strong { font-size: 4.6rem; }
  .badge-1 span { font-size: 1rem; margin-top: 8px; }
  .badge-1 small { font-size: .9rem; max-width: 180px; margin-top: 4px; opacity: .95; }
  .badge-2 {
    width: 180px; height: 180px; right: 0; bottom: 0; background: rgba(30, 22, 20, .9);
    border: 3px dashed var(--amber); transform: rotate(-8deg); box-shadow: 0 10px 40px rgba(0,0,0,.5);
  }
  .badge-2 strong { font-size: 2.6rem; color: var(--amber); }
  .badge-2 span { font-size: .85rem; margin-top: 6px; }
  .badge-2 small { font-size: .85rem; color: #d8cfc8; }

  /* Product tiles */
  .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; max-width: 420px; margin: 0 auto; }
  .tile {
    background: linear-gradient(135deg, #fff7f0, #ffe1cb); border-radius: 18px; aspect-ratio: 4 / 3;
    display: grid; place-items: center; box-shadow: 0 10px 40px rgba(240, 90, 30, .25); transition: transform .2s;
  }
  .tile:hover { transform: translateY(-4px) rotate(-1deg); }
  .tile img { width: 85%; height: 85%; object-fit: contain; }

  /* Controls */
  .controls { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 8px; }
  .arrow {
    width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.05);
    color: #fff; font-size: 1.5rem; line-height: 1; cursor: pointer; display: grid; place-items: center; padding-bottom: 3px;
  }
  .arrow:hover { background: rgba(255, 255, 255, .12); }
  .dots { display: flex; gap: 10px; }
  .dot { width: 10px; height: 10px; border-radius: 999px; border: none; background: rgba(255,255,255,.3); cursor: pointer; padding: 0; transition: width .3s, background .3s; }
  .dot.active { width: 32px; background: var(--grad); }

  /* Stats */
  .stats { display: flex; flex-wrap: wrap; gap: 20px 48px; margin-top: 40px; }
  .stat { border-left: 3px solid var(--orange); padding-left: 22px; }
  .stat strong { display: block; font-family: var(--font-head); font-weight: 800; font-size: 2.4rem; line-height: 1.1; color: #fff; }
  .stat strong span { color: var(--amber); }
  .stat small { color: #b3aba4; font-size: .98rem; }

  @media (max-width: 960px) {
    .slide { padding: 40px 0 16px; }
    .hero-grid { grid-template-columns: 1fr; gap: 16px; min-height: 0; }
    .visual { order: -1; }
    .orbit { width: 250px; height: 250px; }
    .orbit :global(.flame-wrap) { width: 84px; }
    .pill { font-size: .85rem; padding: 7px 14px; margin-bottom: 18px; }
    .float-card { padding: 8px 12px; gap: 8px; }
    .float-card strong { font-size: .82rem; }
    .float-card small { font-size: .7rem; }
    .fc-icon { font-size: 1.1rem; }
    .fc-1 { top: 0; right: -40px; }
    .fc-2 { top: 60%; right: -50px; }
    .fc-3 { top: 30%; bottom: auto; left: -50px; }
    .badges { height: 240px; max-width: 300px; }
    .badge-1 { width: 190px; height: 190px; }
    .badge-1 strong { font-size: 3rem; }
    .badge-1 span { font-size: .78rem; }
    .badge-1 small { font-size: .72rem; max-width: 130px; }
    .badge-2 { width: 124px; height: 124px; }
    .badge-2 strong { font-size: 1.8rem; }
    .badge-2 span, .badge-2 small { font-size: .66rem; }
    .product-grid { max-width: 300px; gap: 12px; }
    .actions .btn { flex: 1 1 auto; }
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .stat { padding-left: 14px; }
    .stat strong { font-size: 1.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .track, .copy { transition: none; }
    .r2, .float-card { animation: none; }
  }
</style>
