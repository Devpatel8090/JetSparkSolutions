---
// Animated SVG flame used in the hero.
---

<div class="flame-wrap" aria-hidden="true">
  <svg class="flame" viewBox="0 0 200 260">
    <defs>
      <linearGradient id="f-outer" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#ff5a00" />
        <stop offset=".55" stop-color="#e2241b" />
        <stop offset="1" stop-color="#b3100f" />
      </linearGradient>
      <linearGradient id="f-mid" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#ffb000" />
        <stop offset="1" stop-color="#ff5a00" />
      </linearGradient>
      <radialGradient id="f-core" cx=".5" cy=".75" r=".5">
        <stop offset="0" stop-color="#fffbe6" />
        <stop offset=".5" stop-color="#ffe066" />
        <stop offset="1" stop-color="#ffb000" />
      </radialGradient>
    </defs>
    <path class="outer" fill="url(#f-outer)"
      d="M100 8 C120 60 170 80 172 150 C174 215 140 252 100 252 C58 252 26 218 28 160 C30 118 52 100 60 70 C70 98 78 108 88 112 C84 70 88 40 100 8Z" />
    <path class="mid" fill="url(#f-mid)"
      d="M104 70 C118 110 150 130 148 175 C146 220 124 240 100 240 C72 240 52 220 54 182 C56 150 74 140 80 118 C88 136 94 142 100 144 C96 118 96 96 104 70Z" />
    <path class="core" fill="url(#f-core)"
      d="M100 140 C112 162 128 176 126 204 C124 226 112 234 100 234 C86 234 74 224 74 204 C74 184 92 172 100 140Z" />
  </svg>
</div>

<style>
  .flame-wrap { width: 150px; filter: drop-shadow(0 0 40px rgba(255, 110, 20, .6)); }
  .flame { width: 100%; overflow: visible; }
  .flame path { transform-origin: 50% 100%; transform-box: fill-box; }
  .outer { animation: flicker 2.2s ease-in-out infinite alternate; }
  .mid { animation: flicker 1.6s ease-in-out infinite alternate-reverse; }
  .core { animation: flicker 1.1s ease-in-out infinite alternate; }
  @keyframes flicker {
    0% { transform: scale(1, 1) skewX(0deg); }
    30% { transform: scale(.97, 1.04) skewX(-2deg); }
    60% { transform: scale(1.02, .97) skewX(2deg); }
    100% { transform: scale(.98, 1.06) skewX(-1deg); }
  }
  @media (prefers-reduced-motion: reduce) { .flame path { animation: none; } }
</style>
