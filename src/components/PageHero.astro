---
import FireBackground from './FireBackground.astro';

interface Props {
  title: string;
  highlight?: string;
  text?: string;
  eyebrow?: string;
}
const { title, highlight, text, eyebrow } = Astro.props;
---

<section class="page-hero fire-section">
  <FireBackground glow="bottom" embers={20} />
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}{highlight && <>{' '}<span class="gradient-text">{highlight}</span></>}</h1>
    {text && <p>{text}</p>}
    <slot />
  </div>
</section>
