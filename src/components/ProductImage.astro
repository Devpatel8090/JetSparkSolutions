---
interface Props {
  image?: string;
  name: string;
  icon: string;
  large?: boolean;
}
const { image, name, icon, large = false } = Astro.props;
---

<div class:list={['pimg', { large }]}>
  {image ? <img src={image} alt={name} loading="lazy" /> : <span aria-hidden="true">{icon}</span>}
</div>

<style>
  .pimg {
    aspect-ratio: 4 / 3; border-radius: 12px; display: grid; place-items: center; overflow: hidden;
    background: linear-gradient(135deg, #fff1e6, #ffd9bf);
  }
  .pimg span { font-size: 3.5rem; }
  .pimg.large span { font-size: 7rem; }
  .pimg img { width: 100%; height: 100%; object-fit: contain; background: #fff; }
</style>
