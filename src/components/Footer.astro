---
import site from '../data/site.json';
const { contact } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <img src="/logo.png" alt={site.name} width="120" class="logo" />
      <p>{site.description}</p>
    </div>
    <div>
      <h3>Quick links</h3>
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/cart">Cart</a></li>
        <li><a href="/about">About us</a></li>
        <li><a href="/contact">Get a quote</a></li>
      </ul>
    </div>
    <div>
      <h3>Contact</h3>
      <ul>
        <li>📞 <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></li>
        <li>✉️ <a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li>📍 {contact.address}</li>
        <li>🕘 {contact.hours}</li>
      </ul>
    </div>
  </div>
  <div class="container copy">© {year} {site.name}. All rights reserved.</div>
</footer>

<style>
  .site-footer { background: #1b1d20; color: #c9cdd2; padding: 56px 0 24px; }
  .cols { display: grid; gap: 32px; grid-template-columns: 1.4fr 1fr 1.4fr; }
  .logo { background: #fff; border-radius: 12px; padding: 8px; margin-bottom: 16px; }
  h3 { color: #fff; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  a { color: #f3a466; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .copy { border-top: 1px solid #33373c; margin-top: 40px; padding-top: 20px; font-size: .9rem; text-align: center; }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; } }
</style>
