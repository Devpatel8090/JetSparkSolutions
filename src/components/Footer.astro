---
import site from '../data/site.json';
import FireBackground from './FireBackground.astro';
const { contact } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer fire-section">
  <FireBackground glow="bottom" embers={12} />
  <div class="container cols">
    <div>
      <a href="/" class="brand">
        <span class="mark"><img src="/favicon.png" alt="" width="34" height="34" /></span>
        <span class="word"><strong>JETSPARK</strong><small>SOLUTIONS</small></span>
      </a>
      <p>{site.description}</p>
      <div class="certs">
        {site.certifications.slice(0, 2).map((c) => <span>{c.icon} {c.title}</span>)}
      </div>
    </div>
    <div>
      <h3>Quick links</h3>
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/shop">Products</a></li>
        <li><a href="/cart">Cart</a></li>
        <li><a href="/about">About us</a></li>
        <li><a href="/contact">Get a quote</a></li>
      </ul>
    </div>
    <div>
      <h3>Contact</h3>
      <ul>
        <li>📞 <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></li>
        <li>✉️ <a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li>📍 {contact.address}</li>
        <li>🕘 {contact.hours}</li>
        <li>🧾 GSTIN: <strong>{contact.gst}</strong></li>
      </ul>
    </div>
  </div>
  <div class="container copy">© {year} {site.name}. All rights reserved. · GSTIN {contact.gst}</div>
</footer>

<style>
  .site-footer { padding: 72px 0 24px; color: #bdb5ae; border-top: 1px solid rgba(255, 255, 255, .08); }
  .cols { display: grid; gap: 40px; grid-template-columns: 1.5fr 1fr 1.5fr; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; margin-bottom: 18px; }
  .mark { width: 46px; height: 46px; border-radius: 12px; background: #fff; display: grid; place-items: center; }
  .word { display: flex; flex-direction: column; line-height: 1; }
  .word strong { color: #fff; font-family: var(--font-head); font-weight: 800; font-size: 1.4rem; }
  .word small { color: #bbb; font-size: .62rem; letter-spacing: 5px; margin-top: 4px; }
  .certs { display: flex; gap: 10px; flex-wrap: wrap; }
  .certs span {
    padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(245, 165, 36, .35); color: var(--amber);
    font-size: .85rem; font-weight: 600;
  }
  h3 { color: #fff; font-size: 1.1rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  a { color: #f3a466; text-decoration: none; }
  a:hover { text-decoration: underline; }
  strong { color: #eee; }
  .copy { border-top: 1px solid rgba(255,255,255,.08); margin-top: 48px; padding-top: 20px; font-size: .88rem; text-align: center; }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; } }
</style>
