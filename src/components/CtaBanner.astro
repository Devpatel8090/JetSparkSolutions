---
import site from '../data/site.json';
import FireBackground from './FireBackground.astro';
---

<section class="cta fire-section">
  <FireBackground glow="bottom" embers={16} />
  <div class="container inner">
    <div>
      <h2>Is your property <span class="gradient-text">fire-safe?</span></h2>
      <p>Book a free site visit and get a clear quotation from {site.name}.</p>
    </div>
    <div class="actions">
      <a href="/contact" class="btn btn-primary">Get Free Quote →</a>
      <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="btn btn-ghost">📞 {site.contact.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding: 72px 0; }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  h2 { margin-bottom: .3em; }
  .inner p { margin: 0; color: #c9c2bc; font-size: 1.08rem; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
