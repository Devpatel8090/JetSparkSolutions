---
import site from '../data/site.json';

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/shop', label: 'Products' },
  { href: '/#industries', label: 'Industries' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href));
const tel = `tel:${site.contact.phone.replace(/\s/g, '')}`;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <span class="mark"><img src="/favicon.png" alt="" width="34" height="34" /></span>
      <span class="word"><strong>JETSPARK</strong><small>SOLUTIONS</small></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Open menu" />
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span></label>

    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
      <div class="nav-actions">
        <a href="/cart" class="cart-link" aria-label="Cart">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
          <span class="cart-text">Cart</span>
          <span class="badge" id="cart-count" hidden>0</span>
        </a>
        <a href={tel} class="btn btn-ghost phone">📞 {site.contact.phone}</a>
        <a href="/contact" class="btn btn-primary quote">Get Free Quote</a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { cartCount } from '../scripts/cart';
  const badge = document.getElementById('cart-count')!;
  const update = () => {
    const n = cartCount();
    badge.textContent = String(n);
    badge.hidden = n === 0;
  };
  document.addEventListener('cart:change', update);
  window.addEventListener('storage', update);
  update();

  // Close the mobile menu after choosing a link (e.g. /#industries on the same page)
  document.querySelectorAll('.site-header nav a').forEach((a) =>
    a.addEventListener('click', () => ((document.getElementById('nav-toggle') as HTMLInputElement).checked = false)),
  );
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; background: rgba(14, 13, 13, .92);
    backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255, 255, 255, .06);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 20px; max-width: 1320px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
  .mark { width: 46px; height: 46px; border-radius: 12px; background: #fff; display: grid; place-items: center; box-shadow: 0 4px 18px rgba(240, 122, 34, .35); }
  .word { display: flex; flex-direction: column; line-height: 1; }
  .word strong { color: #fff; font-family: var(--font-head); font-weight: 800; font-size: 1.4rem; letter-spacing: -.02em; }
  .word small { color: #bbb; font-size: .62rem; letter-spacing: 5px; margin-top: 4px; }

  nav { display: flex; align-items: center; gap: 28px; flex: 1; justify-content: flex-end; }
  nav > a { color: #e8e3df; text-decoration: none; font-weight: 500; position: relative; padding: 6px 0; }
  nav > a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--grad);
    transform: scaleX(0); transition: transform .2s;
  }
  nav > a:hover::after, nav > a.active::after { transform: scaleX(1); }
  nav > a.active { color: #fff; }
  .nav-actions { display: flex; align-items: center; gap: 12px; margin-left: 12px; }
  .nav-actions .btn { padding: 10px 18px; font-size: .95rem; white-space: nowrap; }
  .cart-link { position: relative; color: #fff; display: flex; align-items: center; gap: 6px; text-decoration: none; padding: 8px; }
  .cart-text { display: none; }
  .badge {
    position: absolute; top: -2px; right: -6px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px;
    background: var(--grad); color: #fff; font-size: .72rem; font-weight: 700; display: grid; place-items: center;
  }
  .badge[hidden] { display: none; }
  .nav-toggle, .burger { display: none; }

  @media (max-width: 1240px) { .phone { display: none !important; } nav { gap: 22px; } }
  @media (max-width: 960px) {
    .burger { display: block; width: 30px; height: 22px; position: relative; cursor: pointer; }
    .burger span, .burger span::before, .burger span::after {
      content: ''; position: absolute; left: 0; width: 100%; height: 3px; border-radius: 3px; background: #fff; transition: .2s;
    }
    .burger span { top: 9px; }
    .burger span::before { top: -9px; }
    .burger span::after { top: 9px; }
    .nav-toggle:checked + .burger span { background: transparent; }
    .nav-toggle:checked + .burger span::before { top: 0; transform: rotate(45deg); }
    .nav-toggle:checked + .burger span::after { top: 0; transform: rotate(-45deg); }
    nav {
      display: none; position: absolute; top: 76px; left: 0; right: 0; flex-direction: column; align-items: stretch;
      gap: 0; background: #121010; border-bottom: 1px solid rgba(255,255,255,.08); padding: 8px 16px 20px;
    }
    nav > a { padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.07); }
    nav > a::after { display: none; }
    nav > a.active { color: var(--amber); }
    .nav-toggle:checked ~ nav { display: flex; }
    .nav-actions { margin: 16px 0 0; flex-wrap: wrap; }
    .nav-actions .btn { flex: 1; }
    .phone { display: inline-flex !important; }
    .cart-text { display: inline; }
    .badge { position: static; }
  }
</style>
