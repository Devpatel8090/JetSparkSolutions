---
import Base from '../layouts/Base.astro';
import CtaBanner from '../components/CtaBanner.astro';
import site from '../data/site.json';
const { about } = site;
---

<Base title="About" description={about.paragraphs[0]}>
  <section class="page-hero">
    <div class="container">
      <h1>{about.heading}</h1>
      <p>{site.tagline}</p>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <img src="/logo.png" alt={`${site.name} logo`} width="320" />
      <div>
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <blockquote><strong>Our mission:</strong> {about.mission}</blockquote>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container grid grid-4">
      {site.whyUs.map((w) => (
        <div class="card"><h3>{w.title}</h3><p>{w.text}</p></div>
      ))}
    </div>
  </section>

  <CtaBanner />
</Base>

<style>
  .about { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: center; font-size: 1.08rem; }
  .about img { max-width: 300px; width: 100%; margin: 0 auto; }
  blockquote { margin: 24px 0 0; padding: 18px 22px; border-left: 4px solid var(--orange); background: var(--bg-soft); border-radius: 0 var(--radius) var(--radius) 0; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .about img { max-width: 200px; } }
</style>
