---
import Base from '../layouts/Base.astro';
import CtaBanner from '../components/CtaBanner.astro';
import site from '../data/site.json';
const { about } = site;
---

<Base title="About" description={about.paragraphs[0]}>
  <section class="page-hero">
    <div class="container">
      <h1>{about.heading}</h1>
      <p>{site.tagline}</p>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <div class="logo-col">
        <img src="/logo.png" alt={`${site.name} logo`} width="320" class="only-light" />
        <img src="/logo-dark.png" alt={`${site.name} logo`} width="320" class="only-dark" />
      </div>
      <div>
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <blockquote><strong>Our mission:</strong> {about.mission}</blockquote>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we stand for</span>
        <h2>Our values</h2>
      </div>
      <div class="grid grid-4">
        {about.values.map((v) => (
          <div class="card"><div class="icon-box" aria-hidden="true">{v.icon}</div><h3>{v.title}</h3><p>{v.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</Base>

<style>
  .about { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: start; font-size: 1.08rem; }
  .logo-col { position: sticky; top: 110px; }
  .about .logo-col img { max-width: 300px; width: 100%; margin: 0 auto; }
  blockquote { margin: 24px 0 0; padding: 18px 22px; border-left: 4px solid var(--orange); background: var(--bg-soft); border-radius: 0 var(--radius) var(--radius) 0; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .about .logo-col img { max-width: 200px; } }
</style>
