---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import site from '../data/site.json';
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Fire Safety Experts</span>
        <h1>{site.tagline.split(' ').slice(0, 2).join(' ')} <span class="gradient-text">{site.tagline.split(' ').slice(2).join(' ')}</span></h1>
        <p class="lead">{site.description}</p>
        <div class="actions">
          <a href="/contact" class="btn btn-primary">Get a Free Quote</a>
          <a href="/services" class="btn btn-outline">Our Services</a>
        </div>
      </div>
      <div class="hero-logo">
        <img src="/logo.png" alt={`${site.name} logo`} width="420" />
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container grid grid-3">
      {site.stats.map((s) => (
        <div class="stat"><strong>{s.value}</strong><span>{s.label}</span></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Complete fire safety services</h2>
        <p>Everything you need to prevent, detect and fight fire — under one roof.</p>
      </div>
      <div class="grid grid-3">
        {site.services.map((s) => <ServiceCard service={s} />)}
      </div>
      <p class="center"><a href="/services" class="btn btn-outline">View all services →</a></p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why choose us</span>
        <h2>Safety you can rely on</h2>
      </div>
      <div class="grid grid-4">
        {site.whyUs.map((w) => (
          <div class="card why"><h3>✔ {w.title}</h3><p>{w.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who we serve</span>
        <h2>Industries & premises</h2>
      </div>
      <ul class="chips">
        {site.industries.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <CtaBanner />
</Base>

<style>
  .hero { background: radial-gradient(circle at 80% 30%, #fff1e6, #fff 60%); padding: 64px 0 48px; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 560px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .hero-logo img { margin: 0 auto; max-width: 380px; width: 100%; }
  .stats { background: var(--ink); color: #fff; padding: 32px 0; }
  .stat { text-align: center; }
  .stat strong { display: block; font-family: 'Barlow Condensed', sans-serif; font-size: 2.4rem; color: var(--amber); }
  .stat span { opacity: .85; }
  .center { text-align: center; margin-top: 32px; }
  .why h3 { color: var(--red); font-size: 1.2rem; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .chips li { background: var(--bg-soft); border: 1px solid var(--line); padding: 10px 18px; border-radius: 999px; font-weight: 500; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-logo { order: -1; }
    .hero-logo img { max-width: 220px; }
  }
</style>
