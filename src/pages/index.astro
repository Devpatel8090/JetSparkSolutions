---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import site from '../data/site.json';
import catalogue from '../data/products.json';
import ProductCard from '../components/ProductCard.astro';
import AddToCartScript from '../components/AddToCartScript.astro';

// One or two products from each category for the home page
const featured = catalogue.categories.flatMap((c) =>
  catalogue.products.filter((p) => p.category === c.id && p.price != null).slice(0, 2),
);
---

<Base>
  <HeroCarousel />

  <section class="stats">
    <div class="container grid grid-4">
      {site.stats.map((s) => (
        <div class="stat"><strong>{s.value}{s.suffix}</strong><span>{s.label}</span></div>
      ))}
    </div>
  </section>

  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Complete fire protection solutions</h2>
        <p>From design and installation to maintenance, NOC and training — everything under one roof.</p>
      </div>
      <div class="grid grid-3">
        {site.services.map((s) => <ServiceCard service={s} />)}
      </div>
      <p class="center"><a href="/services" class="btn btn-outline">View all services →</a></p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why choose us</span>
        <h2>Safety you can rely on</h2>
      </div>
      <div class="grid grid-4">
        {site.whyUs.map((w) => (
          <div class="card why"><div class="icon-box" aria-hidden="true">{w.icon}</div><h3>{w.title}</h3><p>{w.text}</p></div>
        ))}
      </div>
      <p class="fine">*Terms & conditions apply.</p>
    </div>
  </section>

  <section class="section" id="products">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Product range</span>
        <h2>BIS-certified fire equipment</h2>
        <p>Complete range of fire fighting products meeting Indian Standards specifications. Order online and pay on delivery or by UPI.</p>
      </div>
      <div class="grid products">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <p class="center"><a href="/shop" class="btn btn-primary">View all products →</a></p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our clients</span>
        <h2>Trusted by satisfied customers</h2>
        <p>{site.clientsIntro}</p>
      </div>
      <div class="clients">
        {site.clients.map((c) => (
          <div class="card client">
            <span class="initials" aria-hidden="true">{c.name.split(/[\s-]+/).map((w) => w[0]).slice(0, 2).join('')}</span>
            <strong>{c.name}</strong>
            {c.location && <small>{c.location}</small>}
          </div>
        ))}
        <div class="card client more">
          <span class="initials" aria-hidden="true">20+</span>
          <strong>and many more</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="industries">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who we serve</span>
        <h2>Institutions we protect</h2>
        <p>{site.institutionsIntro}</p>
      </div>
      <div class="institutions">
        {site.institutions.map((i) => (
          <div class="card inst"><span aria-hidden="true">{i.icon}</span><strong>{i.name}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
  <AddToCartScript />
</Base>

<style>
  .stats { background: var(--ink); color: #fff; padding: 32px 0; }
  .stat { text-align: center; }
  .stat strong { display: block; font-family: 'Barlow Condensed', sans-serif; font-size: 2.4rem; color: var(--amber); }
  .stat span { opacity: .85; }
  .products { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .institutions { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .inst { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; padding: 28px 16px; }
  .inst span { font-size: 2.6rem; }
  .inst strong { font-weight: 600; }
  .inst:hover { border-color: var(--orange); }
  .clients { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
  .client { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; min-width: 200px; padding: 24px; }
  .client .initials {
    width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 700;
    font-size: 1.2rem; background: linear-gradient(135deg, var(--red), var(--orange)); margin-bottom: 6px;
  }
  .client small { color: var(--muted); }
  .more .initials { background: var(--ink); font-size: 1.6rem; }
  .center { text-align: center; margin-top: 32px; }
  .why h3 { font-size: 1.2rem; }
  @media (max-width: 1100px) { .institutions { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 820px) {
    .institutions { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .inst { padding: 20px 10px; }
    .inst span { font-size: 2rem; }
  }
</style>
