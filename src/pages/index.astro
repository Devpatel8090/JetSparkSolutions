---
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProductCard from '../components/ProductCard.astro';
import AddToCartScript from '../components/AddToCartScript.astro';
import FireBackground from '../components/FireBackground.astro';
import CtaBanner from '../components/CtaBanner.astro';
import site from '../data/site.json';
import catalogue from '../data/products.json';

// One or two products from each category for the home page
const featured = catalogue.categories.flatMap((c) =>
  catalogue.products.filter((p) => p.category === c.id && p.price != null).slice(0, 2),
);
---

<Base>
  <HeroCarousel />

  <section class="section section-soft" id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Services</span>
        <h2>Complete Fire Protection <span class="gradient-text">Solutions</span></h2>
        <p>From design and installation to maintenance, NOC and training — everything under one roof.</p>
      </div>
      <div class="grid grid-3">
        {site.services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section" id="products">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Product Range</span>
        <h2>BIS-Certified Fire <span class="gradient-text">Equipment</span></h2>
        <p>Complete range of fire fighting products meeting Indian Standards specifications. Click any product to view full details.</p>
      </div>
      <div class="grid products">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <p class="center"><a href="/shop" class="btn btn-primary">View all products →</a></p>
    </div>
  </section>

  <section class="section fire-section" id="industries">
    <FireBackground glow="center" embers={22} />
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who We Serve</span>
        <h2>Institutions We <span class="gradient-text">Protect</span></h2>
        <p>{site.institutionsIntro}</p>
      </div>
      <div class="institutions">
        {site.institutions.map((i) => (
          <div class="inst"><span aria-hidden="true">{i.icon}</span><strong>{i.name}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why Choose Us</span>
        <h2>Safety You Can <span class="gradient-text">Rely On</span></h2>
      </div>
      <div class="grid grid-4">
        {site.whyUs.map((w) => (
          <div class="card why"><div class="icon-box" aria-hidden="true">{w.icon}</div><h3>{w.title}</h3><p>{w.text}</p></div>
        ))}
      </div>
      <p class="fine">*Terms & conditions apply.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Clients</span>
        <h2>Trusted by <span class="gradient-text">Satisfied Customers</span></h2>
        <p>{site.clientsIntro}</p>
      </div>
      <div class="clients">
        {site.clients.map((c) => (
          <div class="card client">
            <span class="initials" aria-hidden="true">{c.name.split(/[\s-]+/).map((w) => w[0]).slice(0, 2).join('')}</span>
            <strong>{c.name}</strong>
            {c.location && <small>{c.location}</small>}
          </div>
        ))}
        <div class="card client more">
          <span class="initials" aria-hidden="true">20+</span>
          <strong>and many more</strong>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
  <AddToCartScript />
</Base>

<style>
  .products { grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .center { text-align: center; margin-top: 40px; }
  .fine { text-align: center; color: var(--muted); font-size: .85rem; margin: 24px 0 0; }

  .institutions { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .inst {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; text-align: center;
    min-height: 190px; padding: 24px 16px; border-radius: 18px; background: var(--night-card); border: 1px solid var(--night-line);
    transition: transform .2s, border-color .2s, background .2s;
  }
  .inst:hover { transform: translateY(-6px); border-color: rgba(240, 122, 34, .6); background: rgba(240, 122, 34, .08); }
  .inst span { font-size: 3rem; }
  .inst strong { font-weight: 600; font-size: 1.05rem; color: #f1ece8; }

  .why h3 { font-size: 1.15rem; }
  .why:hover { transform: translateY(-4px); }

  .clients { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
  .client { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; min-width: 210px; padding: 28px; }
  .initials {
    width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800;
    font-size: 1.2rem; background: var(--grad); margin-bottom: 8px; font-family: var(--font-head);
  }
  .client small { color: var(--muted); }
  .more .initials { background: var(--ink); }

  @media (max-width: 1100px) { .institutions { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) {
    .institutions { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .inst { min-height: 140px; }
    .inst span { font-size: 2.2rem; }
    .inst strong { font-size: .92rem; }
    .client { min-width: 0; flex: 1 1 40%; padding: 20px 12px; }
  }
</style>
