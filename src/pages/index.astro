---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import site from '../data/site.json';
import catalogue from '../data/products.json';
---

<Base>
  <HeroCarousel />

  <section class="stats">
    <div class="container grid grid-3">
      {site.stats.map((s) => (
        <div class="stat"><strong>{s.value}</strong><span>{s.label}</span></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Complete fire safety services</h2>
        <p>Everything you need to prevent, detect and fight fire — under one roof.</p>
      </div>
      <div class="grid grid-3">
        {site.services.map((s) => <ServiceCard service={s} />)}
      </div>
      <p class="center"><a href="/services" class="btn btn-outline">View all services →</a></p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why choose us</span>
        <h2>Safety you can rely on</h2>
      </div>
      <div class="grid grid-4">
        {site.whyUs.map((w) => (
          <div class="card why"><h3>✔ {w.title}</h3><p>{w.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container shop-teaser">
      <div>
        <span class="eyebrow">Online shop</span>
        <h2>Buy fire safety equipment online</h2>
        <p>Extinguishers, alarm parts, hydrant fittings and safety accessories – order in a few clicks and pay on delivery or by UPI.</p>
        <a href="/shop" class="btn btn-primary">Visit the Shop →</a>
      </div>
      <div class="cats">
        {catalogue.categories.map((c) => (
          <a href="/shop" class="card cat"><span>{c.icon}</span>{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our clients</span>
        <h2>Trusted by satisfied customers</h2>
        <p>{site.clientsIntro}</p>
      </div>
      <div class="clients">
        {site.clients.map((c) => (
          <div class="card client">
            <span class="initials" aria-hidden="true">{c.name.split(/[\s-]+/).map((w) => w[0]).slice(0, 2).join('')}</span>
            <strong>{c.name}</strong>
            {c.location && <small>{c.location}</small>}
          </div>
        ))}
        <div class="card client more">
          <span class="initials" aria-hidden="true">+</span>
          <strong>and many more</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who we serve</span>
        <h2>Industries & premises</h2>
      </div>
      <ul class="chips">
        {site.industries.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <CtaBanner />
</Base>

<style>
  .stats { background: var(--ink); color: #fff; padding: 32px 0; }
  .stat { text-align: center; }
  .stat strong { display: block; font-family: 'Barlow Condensed', sans-serif; font-size: 2.4rem; color: var(--amber); }
  .stat span { opacity: .85; }
  .shop-teaser { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .shop-teaser p { color: var(--muted); }
  .cats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cat { display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: var(--ink); font-weight: 600; padding: 20px; }
  .cat span { font-size: 2rem; }
  .cat:hover { border-color: var(--orange); }
  .clients { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
  .client { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; min-width: 200px; padding: 24px; }
  .client .initials {
    width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 700;
    font-size: 1.2rem; background: linear-gradient(135deg, var(--red), var(--orange)); margin-bottom: 6px;
  }
  .client small { color: var(--muted); }
  .more .initials { background: var(--ink); font-size: 1.6rem; }
  .center { text-align: center; margin-top: 32px; }
  .why h3 { color: var(--red); font-size: 1.2rem; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .chips li { background: var(--bg-soft); border: 1px solid var(--line); padding: 10px 18px; border-radius: 999px; font-weight: 500; }
  @media (max-width: 820px) {
    .shop-teaser { grid-template-columns: 1fr; }
  }
</style>
