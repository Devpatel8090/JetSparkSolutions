---
import Base from '../../layouts/Base.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import AddToCartScript from '../../components/AddToCartScript.astro';
import catalogue from '../../data/products.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return catalogue.products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product: p } = Astro.props;
const cat = catalogue.categories.find((c) => c.id === p.category);
const related = catalogue.products.filter((x) => x.category === p.category && x.id !== p.id).slice(0, 4);
const waText = encodeURIComponent(`Hi ${site.name}, I'm interested in: ${p.name}`);
---

<Base title={p.name} description={p.description}>
  <section class="section">
    <div class="container">
      <nav class="crumbs"><a href="/shop">Shop</a> › <span>{cat?.name}</span></nav>
      <div class="detail">
        <ProductImage image={p.image} name={p.name} icon={cat?.icon ?? '🔥'} large />
        <div>
          <span class="eyebrow">{cat?.name}</span>
          <h1>{p.name}</h1>
          <p class="price">
            {p.price != null ? `₹${p.price.toLocaleString('en-IN')}` : 'Ask for price'}
            {p.price != null && <small> / {p.unit}</small>}
          </p>
          <p>{p.description}</p>
          {p.specs.length > 0 && <ul class="specs">{p.specs.map((s) => <li>{s}</li>)}</ul>}
          {p.inStock ? (
            <div class="buy">
              <label>Qty <input type="number" id="qty" min="1" value="1" /></label>
              <button class="btn btn-primary" data-add-to-cart data-qty-input="qty" data-id={p.id} data-name={p.name} data-price={p.price ?? ''}>
                🛒 Add to cart
              </button>
            </div>
          ) : (
            <p class="oos">Currently out of stock – contact us for availability.</p>
          )}
          <a class="ask" href={`https://wa.me/${site.contact.whatsapp}?text=${waText}`} target="_blank" rel="noopener">💬 Ask about this product on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-soft">
      <div class="container">
        <h2>Related products</h2>
        <div class="grid related">{related.map((r) => <ProductCard product={r} />)}</div>
      </div>
    </section>
  )}

  <AddToCartScript />
</Base>

<style>
  .crumbs { font-size: .9rem; color: var(--muted); margin-bottom: 20px; }
  .crumbs a { text-decoration: none; }
  .detail { display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: start; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .price { font-size: 1.8rem; font-weight: 700; color: var(--red); }
  .price small { font-size: 1rem; color: var(--muted); font-weight: 500; }
  .specs { color: var(--muted); padding-left: 20px; }
  .buy { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 24px 0 16px; }
  .buy label { display: flex; align-items: center; gap: 8px; font-weight: 500; }
  .buy input { width: 72px; font: inherit; padding: 10px; border: 1px solid var(--line); border-radius: 10px; }
  .ask { display: inline-block; margin-top: 4px; font-weight: 500; }
  .oos { color: var(--muted); font-weight: 600; }
  .related { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  @media (max-width: 820px) { .detail { grid-template-columns: 1fr; gap: 24px; } }
</style>
