---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import site from '../data/site.json';
---

<Base title="Services" description={`Fire safety services by ${site.name}: ${site.services.map((s) => s.title).join(', ')}.`}>
  <section class="page-hero">
    <div class="container">
      <h1>Our Services</h1>
      <p>Supply, installation, maintenance and compliance — handled by one trusted team.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-3">
      {site.services.map((s) => <ServiceCard service={s} detailed />)}
    </div>
  </section>

  <CtaBanner />
</Base>
