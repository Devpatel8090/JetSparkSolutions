---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const { contact } = site;
---

<Base title="Contact" description={`Contact ${site.name} for a free fire safety quote. Call ${contact.phone}.`}>
  <PageHero eyebrow="Contact" title="Get Your Free" highlight="Quote" text="Tell us what you need and we'll get back to you with a free quotation — usually the same day." />

  <section class="section">
    <div class="container contact">
      <div class="card info">
        <h2>Get in touch</h2>
        <p>📞 <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></p>
        <p>💬 <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener">Chat on WhatsApp</a></p>
        <p>✉️ <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        <p>📍 {contact.address}</p>
        <p>🕘 {contact.hours}</p>
        <p>🧾 GSTIN: <strong>{contact.gst}</strong></p>
        <div class="certs">{site.certifications.slice(0, 2).map((c) => <span>{c.icon} {c.title}</span>)}</div>
        {contact.mapEmbedUrl && (
          <iframe src={contact.mapEmbedUrl} title="Office location" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        )}
      </div>

      <!-- Netlify Forms: submissions appear in the Netlify dashboard and can be emailed to Jay. -->
      <form class="card" name="enquiry" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="company-website">
        <input type="hidden" name="form-name" value="enquiry" />
        <p hidden><label>Leave empty <input name="company-website" /></label></p>
        <h2>Request a quote</h2>
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Phone<input name="phone" type="tel" required autocomplete="tel" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" /></label>
        <label>Service needed
          <select name="service">
            <option value="">Select a service</option>
            {site.services.map((s) => <option>{s.title}</option>)}
            <option>Buy products</option>
            <option>2-year AMC offer (3rd year free)</option>
            <option>Other</option>
          </select>
        </label>
        <label>Message<textarea name="message" rows="4"></textarea></label>
        <button type="submit" class="btn btn-primary">Send Enquiry</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1.3fr; gap: 32px; align-items: start; }
  .info p { color: var(--ink); }
  .certs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .certs span { padding: 6px 12px; border-radius: 999px; background: #fff4e8; color: #b0470c; font-weight: 600; font-size: .88rem; }
  iframe { width: 100%; height: 240px; border: 0; border-radius: 10px; margin-top: 8px; }
  form { display: grid; gap: 14px; }
  label { display: grid; gap: 6px; font-weight: 500; }
  input, select, textarea {
    font: inherit; padding: 11px 14px; border: 1px solid var(--line); border-radius: 10px; background: #fff;
  }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--orange); border-color: transparent; }
  button { justify-self: start; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } }
</style>
